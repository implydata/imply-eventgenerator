    {
      "name": "emit_search", "type": "activity",
      "_comment": "Search engine traffic",
      "variables": [
        {"name": "var_appclass", "type": "string:static", "value": "General Browsing"},
        {"name": "var_appname", "type": "string:static", "value": "Google Search"},
        {"name": "var_hostname", "type": "string:static", "value": "www.google.com"},
        {"name": "var_urlcategory", "type": "string:static", "value": "Search Engines and Portals"},
        {"name": "var_urlclass", "type": "string:static", "value": "Reference"},
